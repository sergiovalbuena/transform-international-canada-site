---
import '../styles/global.css';
import displayFont from '@fontsource-variable/fraunces/files/fraunces-latin-soft-normal.woff2?url';
import bodyFont from '@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url';
import SEO from '../components/layout/SEO.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  /** The page's largest above-the-fold image, preloaded for a fast first paint. */
  preload?: { srcset: string; sizes: string; type: string };
}

const { preload, ...props } = Astro.props;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    {
      preload && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preload.srcset}
          imagesizes={preload.sizes}
          type={preload.type}
          fetchpriority="high"
        />
      )
    }
    <SEO {...props} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fbf7f0" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <Analytics />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1" class="grow">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/reveal';
      import '../scripts/counters';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-cream);
    font-weight: 700;
    text-decoration: none;
    translate: 0 -200%;
  }
  .skip-link:focus {
    translate: 0 0;
  }
  main:focus {
    outline: none;
  }
</style>
