---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="We couldn’t find that page." noindex>
  <section class="nf" aria-labelledby="page-title">
    <div class="container-site nf-inner">
      <p class="eyebrow">Error 404</p>
      <h1 id="page-title" class="heading-xl">This path doesn’t <em>lead anywhere</em> — yet.</h1>
      <p class="lede">
        The page may have moved. Try the home page, our programs or our latest stories.
      </p>
      <div class="nf-actions">
        <Button href="/" variant="primary" size="lg">Go to the home page</Button>
        <Button href="/what-we-do/" variant="outline" size="lg">See our programs</Button>
        <Button href="/stories/" variant="outline" size="lg">Read our stories</Button>
      </div>
    </div>
    <div class="ribbon" aria-hidden="true"></div>
  </section>
</BaseLayout>

<style>
  .nf {
    background: var(--color-gold-100);
  }
  .nf-inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(5rem, 4rem + 6vw, 9rem);
  }
  .nf-inner h1 {
    max-width: 18ch;
  }
  .nf-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }
</style>
