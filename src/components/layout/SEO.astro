---
/**
 * Everything search engines and social networks read: title, description,
 * canonical address, Open Graph and Twitter card tags, and the share image
 * (cropped to 1200×630 from the page's main photo).
 */
import { getImage } from 'astro:assets';
import { photo } from '../../lib/images';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const { title, description, image = 'photos/youth-trades/mechanics-workshop.jpg', imageAlt, noindex } = Astro.props;
const siteName = 'Transform International (Canada)';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const share = await getImage({ src: photo(image), width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
const shareUrl = new URL(share.src, Astro.site).href;
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_CA" />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:image" content={shareUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{imageAlt && <meta property="og:image:alt" content={imageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={shareUrl} />
{imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
