  growth: '<path d="M3.5 20.5h17"/><path d="m4.5 15.5 5-5 3.5 3.5 6.5-6.5"/><path d="M15 7.5h4.5V12"/>',
  home: '<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9v11.5h13V9"/><path d="M10 20.5v-6h4v6"/>',
  // Interface
  arrow: '<path d="M4 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  'arrow-down': '<path d="M12 4v15"/><path d="m6 13.5 6 6 6-6"/>',
  external: '<path d="M14 4h6v6"/><path d="M20 4 11 13"/><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  menu: '<path d="M3.5 7h17"/><path d="M3.5 12h17"/><path d="M3.5 17h11"/>',
  close: '<path d="m5.5 5.5 13 13"/><path d="m18.5 5.5-13 13"/>',
  chevron: '<path d="m6 9 6 6 6-6"/>',
  check: '<path d="m4.5 12.5 4.5 4.5 10.5-10.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/>',
