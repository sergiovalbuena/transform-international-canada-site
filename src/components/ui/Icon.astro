  energy:
    '<path d="M12 21c-3.6 0-6-2.4-6-5.6 0-3.3 2.4-5 3.6-7.6.8 1.3 1.1 2.4 1.2 3.4C13 9.6 13.7 6.6 13.2 3c3.2 2.3 4.8 6.3 4.8 9.6V15c0 3.4-2.5 6-6 6Z"/><path d="M12 21c-1.6 0-2.7-1.1-2.7-2.6 0-1.6 1.3-2.6 2.7-4.2 1.4 1.6 2.7 2.6 2.7 4.2 0 1.5-1.1 2.6-2.7 2.6Z"/>',
