    '<path d="M2.5 14.5 6 11a3 3 0 0 1 2.1-.9H12a1.6 1.6 0 0 1 0 3.2H9.5"/><path d="M2.5 19.5 4.5 17.5h7.2a3 3 0 0 0 2.1-.9l5.5-5.5a1.6 1.6 0 0 0-2.3-2.3l-3.2 3.2"/><path d="M15.5 6.8a2.3 2.3 0 0 1 3.9-1.6 2.3 2.3 0 0 1 0 3.2L17 10.7l-1.5-1.4"/>',
