  // Ways to help
  heart:
    '<path d="M12 20.3S3.8 15.4 3.8 9.4A4.3 4.3 0 0 1 12 7.3a4.3 4.3 0 0 1 8.2 2.1c0 6-8.2 10.9-8.2 10.9Z"/>',
  gift:
