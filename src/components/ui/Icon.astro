  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  shield: '<path d="M12 3 4.5 6v5.5c0 4.6 3.1 8 7.5 9.5 4.4-1.5 7.5-4.9 7.5-9.5V6Z"/><path d="m8.8 12 2.3 2.3 4.3-4.6"/>',
  document: '<path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 12h6"/><path d="M9 16h6"/>',
  facebook:
    '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4A21 21 0 0 0 15.3 4.3c-2.3 0-3.9 1.4-3.9 4v2.2H8.8v3h2.6V21"/>',
  quote:
    '<path d="M9.5 6.5C6 7.5 4 10.2 4 13.5V18h5.5v-5.5H6.6c.2-1.9 1.4-3.4 3.4-4Z"/><path d="M19 6.5c-3.5 1-5.5 3.7-5.5 7V18H19v-5.5h-2.9c.2-1.9 1.4-3.4 3.4-4Z"/>',
} as const;

export type IconName = keyof typeof paths;

interface Props extends HTMLAttributes<'svg'> {
  name: IconName;
  size?: number;
  label?: string;
}

const { name, size = 24, label, ...rest } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  {...rest}
  set:html={paths[name]}
/>
