---
/**
 * The site's custom line-icon set: drawn on a 24px grid with a 1.75px round
 * stroke so every icon has the same weight. Decorative by default; pass
 * `label` when the icon is the only content of a link or button.
 */
import type { HTMLAttributes } from 'astro/types';

const paths = {
