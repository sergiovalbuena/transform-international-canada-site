---
/**
 * Buttons. `donate` is the warm gold used for every giving action, so the
 * colour itself comes to mean "give". Links that leave the site (Zeffy, email)
 * are detected automatically and announced to screen-reader users.
 */
import Icon, { type IconName } from './Icon.astro';

interface Props {
  href: string;
  variant?: 'donate' | 'primary' | 'outline' | 'outline-light';
  size?: 'md' | 'lg';
  icon?: IconName;
  class?: string;
  /** Extra text for screen readers when the visible label alone is ambiguous. */
  srContext?: string;
}

const { href, variant = 'primary', size = 'md', icon, class: className, srContext } = Astro.props;
const external = /^https?:\/\//.test(href);
const trailingIcon: IconName | undefined = icon ?? (external ? 'external' : undefined);
---

<a
  href={href}
  class:list={['btn', `btn-${variant}`, `btn-${size}`, className]}
  rel={external ? 'noopener' : undefined}
>
  <span class="btn-label"><slot /></span>
  {srContext && <span class="visually-hidden">{srContext}</span>}
  {
    external && (
      <span class="visually-hidden">
        {href.includes('zeffy.com') ? '(opens the secure Zeffy donation form)' : '(opens another website)'}
      </span>
    )
  }
  {trailingIcon && <Icon name={trailingIcon} size={18} class="btn-icon" />}
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-height: 48px;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-pill);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    text-align: center;
    text-wrap: balance;
    overflow: hidden;
    transition:
      background-color var(--duration-base) var(--ease-out),
      color var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out);
  }
  .btn-lg {
    min-height: 56px;
    padding: 1rem 1.9rem;
    font-size: 1.0625rem;
  }
  .btn-icon {
    flex: none;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .btn-donate {
    background: var(--color-donate);
    color: var(--color-donate-ink);
    box-shadow: 0 6px 18px -8px rgb(168 88 40 / 0.6);
  }
  /* A gentle sheen sweeps across the donate button on hover. */
  .btn-donate::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.45) 50%, transparent 70%);
    translate: -110% 0;
  }
  .btn-primary {
    background: var(--color-green-700);
    color: #fff;
  }
  .btn-outline {
    border: 2px solid currentColor;
    color: var(--color-green-800);
    background: transparent;
  }
  .btn-outline-light {
    border: 2px solid rgb(251 247 240 / 0.85);
    color: var(--color-cream);
    background: rgb(15 36 24 / 0.18);
    backdrop-filter: blur(6px);
  }

  @media (hover: hover) {
    .btn:hover {
      transform: translateY(-2px);
    }
    .btn:hover .btn-icon {
      transform: translateX(3px);
    }
    .btn-donate:hover {
      background: var(--color-donate-hover);
      box-shadow: 0 12px 26px -10px rgb(168 88 40 / 0.7);
    }
    .btn-donate:hover::after {
      translate: 110% 0;
      transition: translate 800ms var(--ease-out);
    }
    .btn-primary:hover {
      background: var(--color-green-800);
    }
    .btn-outline:hover {
      background: var(--color-green-800);
      border-color: var(--color-green-800);
      color: #fff;
    }
    .btn-outline-light:hover {
      background: var(--color-cream);
      color: var(--color-ink);
    }
  }
  .btn:active {
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn-icon {
      transition: none;
    }
    .btn:hover,
    .btn:hover .btn-icon {
      transform: none;
    }
    .btn-donate::after {
      display: none;
    }
  }
</style>
