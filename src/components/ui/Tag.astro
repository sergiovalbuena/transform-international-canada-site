---
/** A small label in a program's colour. Text colour is chosen to pass WCAG AA on that fill. */
import type { accents } from '../../content.config';

interface Props {
  accent: (typeof accents)[number];
  class?: string;
}

const { accent, class: className } = Astro.props;
---

<span class:list={['tag', className]} style={`--bg: var(--color-${accent}); --fg: var(--color-${accent}-on)`}>
  <slot />
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--fg);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    line-height: 1.3;
  }
</style>
