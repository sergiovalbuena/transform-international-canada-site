---
import { Image } from 'astro:assets';
import type { BlockOf } from '../../content.config';
import Icon from '../ui/Icon.astro';
import { photo } from '../../lib/images';

type Props = BlockOf<'quoteBand'>;
const { quote, attribution, context, image, imageAlt, link } = Astro.props;
---

<!--
  The photo is optional. Only pair a quote with a photo of the speaker, or of
  a place with no identifiable person, so readers don't assume someone in the
  picture said the words.
-->
<section class:list={['section band-green quote-band', { 'has-photo': image }]} aria-label="In their words">
  <div class="container-site quote-grid">
    {
      image && (
        <figure class="quote-photo" data-reveal>
          <Image src={photo(image)} alt={imageAlt ?? ''} widths={[360, 560, 760]} sizes="(min-width: 64rem) 30vw, 70vw" />
        </figure>
      )
    }
    <figure class="quote-figure" data-reveal="2">
      <Icon name="quote" size={56} class="quote-mark" />
      <blockquote class="quote-text">
        <p>{quote}</p>
      </blockquote>
      <figcaption class="quote-cite">
        <span class="quote-name">{attribution}</span>
        <span class="quote-context">{context}</span>
      </figcaption>
      {
        link && (
          <a href={link.href} class="link-arrow quote-link">
            {link.label}
            <Icon name="arrow" size={20} />
          </a>
        )
      }
    </figure>
  </div>
</section>

<style>
  .quote-band {
    position: relative;
    overflow: hidden;
  }
  /* Soft sunrise glow in the corner, so the band feels warm rather than flat. */
  .quote-band::before {
    content: '';
    position: absolute;
    right: -20rem;
    top: -20rem;
    width: 46rem;
    height: 46rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(242 196 107 / 0.22), transparent 65%);
    pointer-events: none;
  }
  .quote-grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  .quote-photo {
    max-width: 22rem;
  }
  .quote-photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 30% 50%;
    border-radius: 999px 999px var(--radius-lg) var(--radius-lg);
    border: 6px solid rgb(251 247 240 / 0.12);
  }
  .quote-figure {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .quote-figure :global(.quote-mark) {
    color: var(--color-gold-300);
    stroke-width: 1.4;
  }
  .quote-text {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--text-step-3);
    font-weight: 450;
    line-height: 1.3;
    letter-spacing: -0.01em;
    max-width: 30em;
  }
  .quote-cite {
    display: grid;
    gap: 0.2rem;
    padding-left: 1.25rem;
    border-left: 4px solid var(--color-gold-300);
  }
  .quote-name {
    font-weight: 700;
  }
  .quote-context {
    color: rgb(251 247 240 / 0.8);
    font-size: 0.975rem;
  }

  /* Without a photo the quote stands alone, larger, with the quote mark
     hanging in the margin. */
  .quote-band:not(.has-photo) .quote-figure {
    max-width: 60rem;
  }
  .quote-band:not(.has-photo) .quote-text {
    font-size: clamp(1.5rem, 1.1rem + 1.9vw, 2.6rem);
    line-height: 1.25;
    max-width: none;
  }

  @media (min-width: 64rem) {
    .quote-band.has-photo .quote-grid {
      grid-template-columns: 0.75fr 2fr;
      gap: 5rem;
    }
    .quote-band:not(.has-photo) .quote-figure {
      position: relative;
      padding-left: 7rem;
    }
    .quote-band:not(.has-photo) .quote-figure :global(.quote-mark) {
      position: absolute;
      left: 0;
      top: 0.4rem;
      width: 84px;
      height: 84px;
    }
  }
</style>
