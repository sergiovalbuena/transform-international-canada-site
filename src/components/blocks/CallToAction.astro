---
import type { BlockOf } from '../../content.config';
import Button from '../ui/Button.astro';
import { emphasize } from '../../lib/content';

type Props = BlockOf<'callToAction'>;
const { heading, text, primary, secondary } = Astro.props;
---

<section class="section band-sand cta" aria-labelledby="cta-title">
  <div class="container-site cta-inner" data-reveal>
    <h2 id="cta-title" class="heading-lg" set:html={emphasize(heading)} />
    <p class="lede">{text}</p>
    <div class="cta-actions">
      <Button href={primary.href} variant="donate" size="lg" icon="heart">{primary.label}</Button>
      {secondary && <Button href={secondary.href} variant="outline" size="lg">{secondary.label}</Button>}
    </div>
  </div>
</section>

<style>
  .cta-inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 52rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
</style>
