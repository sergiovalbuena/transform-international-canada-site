---
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Button from '../ui/Button.astro';
import Tag from '../ui/Tag.astro';
import { photo } from '../../lib/images';
import { HERO_WIDTHS } from '../../lib/hero';

interface Props {
  project: CollectionEntry<'projects'>;
  secondary?: { label: string; href: string };
}

const { project, secondary } = Astro.props;
const p = project.data;
---

<section class="p-hero" style={`--accent: var(--color-${p.accent})`} aria-labelledby="page-title">
  <div class="p-hero-media">
    <Picture
      src={photo(p.image)}
      alt={p.imageAlt}
      formats={['avif', 'webp']}
      widths={HERO_WIDTHS}
      sizes="100vw"
      priority
      style={`object-position: ${p.imagePosition}`}
    />
  </div>
  <div class="p-hero-shade" aria-hidden="true"></div>
  <div class="container-site p-hero-content">
    <nav aria-label="Breadcrumb" class="crumbs">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/what-we-do/">Our work</a></li>
        <li aria-current="page">{p.shortTitle}</li>
      </ol>
    </nav>
    <Tag accent={p.accent}>{p.place}</Tag>
    {p.headline && <p class="p-program">{p.title}</p>}
    <h1 id="page-title" class:list={['p-title', { 'is-headline': p.headline }]}>{p.headline ?? p.title}</h1>
    <p class="p-summary">{p.subtitle ?? p.summary}</p>
    <div class="p-actions">
      <Button href={p.zeffyUrl} variant="donate" size="lg" icon="heart">Support this program</Button>
      {secondary && <Button href={secondary.href} variant="outline-light" size="lg" icon="arrow-down">{secondary.label}</Button>}
    </div>
    <p class="p-partner">With our partner <strong>{p.partner}</strong></p>
  </div>
  <div class="p-hero-bar" aria-hidden="true"></div>
</section>

<style>
  .p-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: clamp(34rem, 80svh, 46rem);
    overflow: hidden;
    isolation: isolate;
    color: var(--color-cream);
    background: var(--color-green-900);
  }
  .p-hero-media,
  .p-hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .p-hero-media :global(picture),
  .p-hero-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
  }
  .p-hero-shade {
    background:
      linear-gradient(to top, rgb(8 43 23 / 0.94) 0%, rgb(8 43 23 / 0.6) 45%, rgb(8 43 23 / 0.1) 80%),
      linear-gradient(to right, rgb(8 43 23 / 0.5), rgb(8 43 23 / 0) 65%);
  }
  .p-hero-content {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-block: 7rem 4rem;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.9rem;
    color: rgb(251 247 240 / 0.85);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.6;
  }
  .crumbs a {
    color: inherit;
    text-underline-offset: 3px;
  }
  .p-program {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: var(--text-step-2);
    font-weight: 600;
    color: var(--color-gold-300);
  }
  .p-title.is-headline {
    max-width: 20ch;
    font-size: var(--text-step-5);
  }
  .p-title {
    max-width: 18ch;
    font-size: var(--text-step-5);
    font-weight: 580;
    line-height: 1.02;
  }
  .p-summary {
    max-width: 38rem;
    font-size: var(--text-step-1);
    line-height: 1.5;
    color: rgb(251 247 240 / 0.92);
  }
  .p-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 0.75rem;
  }
  .p-partner {
    font-size: 0.95rem;
    color: rgb(251 247 240 / 0.8);
  }
  .p-partner strong {
    color: var(--color-cream);
    font-weight: 600;
  }
  .p-hero-bar {
    position: absolute;
    inset: auto 0 0 0;
    height: 8px;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .p-hero-media :global(img) {
      animation: p-zoom 20s var(--ease-out) both;
    }
  }
  @keyframes p-zoom {
    from {
      transform: scale(1.08);
    }
    to {
      transform: scale(1);
    }
  }
</style>
