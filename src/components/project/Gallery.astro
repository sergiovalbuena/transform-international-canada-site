---
import { Image } from 'astro:assets';
import { photo } from '../../lib/images';

interface Props {
  items: { image: string; alt: string; caption?: string }[];
  title: string;
}

const { items, title } = Astro.props;
---

<section class="section band-sand gallery" aria-labelledby="gallery-title">
  <div class="container-site">
    <p class="eyebrow" data-reveal>In pictures</p>
    <h2 id="gallery-title" class="heading-md gallery-title" data-reveal>{title}</h2>
    <ul class:list={['gallery-grid', `count-${Math.min(items.length, 5)}`]}>
      {
        items.map((item, i) => (
          <li class={`shot shot-${i + 1}`} data-reveal={(i % 3) + 1}>
            <figure>
              <Image
                src={photo(item.image)}
                alt={item.alt}
                widths={[360, 640, 960]}
                sizes={i === 0 || items.length === 3 ? '(min-width: 64rem) 45vw, 100vw' : '(min-width: 64rem) 25vw, 50vw'}
              />
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery-title {
    margin-top: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .gallery-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .shot-1 {
    grid-column: 1 / -1;
  }
  figure {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-md);
  }
  figure :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .shot-1 figure :global(img) {
    aspect-ratio: 16 / 9;
    object-position: 50% 30%;
  }
  figcaption {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    right: 0.75rem;
    justify-self: start;
    width: fit-content;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    background: rgb(8 43 23 / 0.82);
    color: var(--color-cream);
    font-size: 0.85rem;
    line-height: 1.4;
  }

  @media (min-width: 64rem) {
    .gallery-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 15rem;
    }
    .shot-1 {
      grid-column: span 2;
      grid-row: span 2;
    }
    /* Three photos: one large, two stacked beside it. */
    .count-3 .shot:not(.shot-1) {
      grid-column: span 2;
    }
    figure :global(img),
    .shot-1 figure :global(img) {
      aspect-ratio: auto;
    }
  }
</style>
